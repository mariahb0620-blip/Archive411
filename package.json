{
  "name": "archive411",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:mobile": "next dev --turbopack -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "icons": "node scripts/generate-icons.mjs",
    "images:generate": "node scripts/generate-catalog-images.mjs",
    "cap:sync": "cap sync",
    "cap:ios": "cap open ios",
    "cap:android": "cap open android",
    "mobile:setup": "npm run icons && cap add ios && cap add android",
    "catalog:verify": "npx tsx scripts/verify-catalog.ts",
    "catalog:verify-links": "npx tsx scripts/verify-product-links.ts",
    "catalog:coverage": "npx tsx scripts/catalog-coverage.ts",
    "catalog:stale": "npx tsx scripts/catalog-stale.ts",
    "catalog:import": "npx tsx scripts/catalog-import.ts",
    "catalog:enrich-sample": "npx tsx scripts/catalog-enrich-sample.ts",
    "catalog:pipeline-test": "npx tsx scripts/catalog-pipeline-test.ts",
    "catalog:discover-shopify": "node scripts/discover-shopify-products.mjs",
    "catalog:seed": "npx tsx scripts/seed-supabase.ts",
    "beta:test": "npx tsx scripts/beta-journey-test.ts",
    "beta:rls": "npx tsx scripts/beta-rls-test.ts",
    "vercel:journey": "npx tsx scripts/vercel-journey-test.ts",
    "e2e:test": "playwright test",
    "e2e:vercel": "playwright test e2e/vercel-journey.spec.ts",
    "e2e:mobile": "playwright test e2e/vercel-journey.spec.ts --project=iphone-safari --project=android-chrome",
    "qa:all": "npm run catalog:verify && npm run catalog:pipeline-test && npm run catalog:coverage && npm run catalog:verify-links && npm run beta:test && npm run beta:rls",
    "deploy:preview": "vercel deploy",
    "db:migrate": "npx tsx scripts/apply-migration.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.1",
    "framer-motion": "^11.18.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "pg": "^8.22.0",
    "postcss": "^8.4.49",
    "sharp": "^0.35.3",
    "supabase": "^2.111.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vercel": "^58.7.1"
  }
}
