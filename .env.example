# Public app URL (production)
NEXT_PUBLIC_APP_URL=https://archive411.vercel.app

# Beta feedback — Google Form or Tally URL (optional; defaults to email)
NEXT_PUBLIC_BETA_FEEDBACK_URL=

# Rakuten affiliate redirect base URL
NEXT_PUBLIC_RAKUTEN_REDIRECT=https://click.linksynergy.com/fs-bin/click
RAKUTEN_TRACKING_BASE=https://click.linksynergy.com/deeplink
RAKUTEN_AFFILIATE_ID=
RAKUTEN_MID=

# Impact.com affiliate redirect base URL
NEXT_PUBLIC_IMPACT_REDIRECT=https://your-impact-tracking-url.com
IMPACT_TRACKING_BASE=https://your-impact-tracking-url.com/deeplink
IMPACT_CAMPAIGN_ID=
IMPACT_MEDIA_PARTNER_ID=

# Capacitor native shell — point to deployed app or local dev server
# Production: CAPACITOR_SERVER_URL=https://archive411.studio
# Local LAN:  CAPACITOR_SERVER_URL=http://192.168.1.151:3000
CAPACITOR_SERVER_URL=

# Supabase (Auth + Postgres + RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to client (use sb_secret_... or legacy service_role key)
SUPABASE_SERVICE_ROLE_KEY=
# Database password for migrations only (Dashboard → Settings → Database)
SUPABASE_DB_PASSWORD=

# Optional — advisory tag enrichment only (NOT used for product existence verification)
OPENAI_API_KEY=

# Catalog verification recheck window (days) — npm run catalog:stale
VERIFICATION_MAX_AGE_DAYS=7

# Rakuten Advertising product ingestion (optional — scaffold ready)
RAKUTEN_ACCESS_TOKEN=
RAKUTEN_PRODUCT_SEARCH_URL=
